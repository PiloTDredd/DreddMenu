<ui:FluentWindow
    x:Class="DreddMenu.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:DreddMenu"
    xmlns:core="clr-namespace:DreddMenu.Core"
    Title="Dredd Menu"
    Icon="pack://application:,,,/Assets/app.ico"
    Width="1260" Height="780" MinWidth="900" MinHeight="560"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="PageSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,18,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Пункт левого меню -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="0,2" Padding="14,10" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <Rectangle x:Name="Indicator" Width="3" Height="16" Margin="-14,0,0,0"
                                           HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavTemplate" DataType="{x:Type local:NavItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                           Text="{Binding Title}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Grid.Column="2" Style="{StaticResource Badge}" Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Count}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Карточка пункта меню -->
        <DataTemplate x:Key="EntryCard" DataType="{x:Type core:MenuEntry}">
            <Border x:Name="Card" Margin="0,0,0,6" Padding="16,12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBox" Width="40" Height="40" CornerRadius="8" VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <Image Width="24" Height="24" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="{Binding FallbackSymbol}" FontSize="20"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="Texts" Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" Margin="0,0,0,2"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding KindLabel}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{DynamicResource Badge.Mine}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding IsExtended, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{DynamicResource Tip.Shift}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="Shift" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{DynamicResource Tip.System}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{DynamicResource Badge.System}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="#33E8A33D"
                                    Visibility="{Binding IsBroken, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Tip.Broken}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="11" Foreground="#E8A33D" Margin="0,0,4,0" />
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="#E8A33D" Text="{DynamicResource Badge.Broken}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{DynamicResource Badge.Changed}"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Margin="0,3,0,0" FontSize="12" Text="{Binding Subtitle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Text="{Binding Details}" ToolTip="{Binding Details}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ui:Button Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" Appearance="Transparent"
                               Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                               ToolTip="{DynamicResource Tip.DeleteItem}" Tag="{Binding}" Click="DeleteCustom_Click">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:ToggleSwitch Grid.Column="3" VerticalAlignment="Center"
                                     IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     OnContent="{DynamicResource Toggle.On}" OffContent="{DynamicResource Toggle.Off}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="IconBox" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Texts" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Строка предпросмотра меню -->
        <DataTemplate x:Key="PreviewRow" DataType="{x:Type local:PreviewItem}">
            <Grid>
                <Border Height="1" Margin="4,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />
                <Grid Margin="0,0" Visibility="{Binding IsItem, Converter={StaticResource BoolToVis}}">
                    <Border x:Name="Row" Padding="10,6" CornerRadius="4" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="16" Height="16" Source="{Binding Icon}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="12" Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Карточка бэкапа -->
        <DataTemplate x:Key="BackupCard" DataType="{x:Type core:Backup}">
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="History24" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding CreatedText}" />
                        <TextBlock Style="{StaticResource CardText}" Text="{Binding Summary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="{DynamicResource Backups.Restore}" Tag="{Binding}" Click="RestoreBackup_Click" />
                        <ui:Button Margin="6,0,0,0" Appearance="Transparent" Tag="{Binding}" Click="DeleteBackup_Click"
                                   ToolTip="{DynamicResource Tip.DeleteBackup}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Строка проверки системы -->
        <DataTemplate x:Key="CheckRow" DataType="{x:Type core:CheckResult}">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="Ic" Symbol="{Binding Symbol}" FontSize="20" Filled="True" VerticalAlignment="Top" Margin="0,1,0,0"
                               Foreground="#3FB950" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Style="{StaticResource CardTitle}" FontSize="13" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource CardText}" Margin="0,1,0,0" Text="{Binding Detail}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="Ic" Property="Foreground" Value="#E8A33D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Ic" Property="Foreground" Value="#F85149" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Dredd Menu">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Левая панель ===== -->
            <DockPanel Margin="12,0,10,14">
                <StackPanel DockPanel.Dock="Top" Margin="14,6,0,18">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Dredd Menu"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Text="{DynamicResource App.Subtitle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="4,10,4,0" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="AdminIcon" Symbol="Shield24" FontSize="16" VerticalAlignment="Top" />
                        <TextBlock x:Name="AdminText" Grid.Column="1" Margin="8,0,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ItemTemplate="{StaticResource NavTemplate}"
                         SelectionChanged="NavList_SelectionChanged" />
            </DockPanel>

            <!-- ===== Правая часть ===== -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>

                    <!-- ================= Список пунктов меню ================= -->
                    <Grid x:Name="EntriesPanel" Margin="28,22,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,10,0">
                            <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubStyle}" />
                        </StackPanel>

                        <!-- Доп. шапка: Windows 11 -->
                        <Border x:Name="Win11Card" Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,10,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Apps24" FontSize="22" />
                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Win11.Classic.Title}" />
                                    <TextBlock Style="{StaticResource CardText}" Text="{DynamicResource Win11.Classic.Desc}" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ClassicToggle" Grid.Column="2" VerticalAlignment="Center"
                                                 OnContent="{DynamicResource Toggle.On}" OffContent="{DynamicResource Toggle.Off}"
                                                 Click="ClassicToggle_Click" />
                            </Grid>
                        </Border>

                        <!-- Доп. шапка: типы файлов -->
                        <StackPanel x:Name="FileTypeBar" Grid.Row="1" Margin="0,16,10,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox x:Name="ExtBox" Width="240" PlaceholderText="{DynamicResource FileTypes.Placeholder}"
                                            KeyDown="ExtBox_KeyDown">
                                    <ui:TextBox.Icon>
                                        <ui:SymbolIcon Symbol="Document24" />
                                    </ui:TextBox.Icon>
                                </ui:TextBox>
                                <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="{DynamicResource FileTypes.Show}" Click="ShowFileType_Click" />
                            </StackPanel>
                            <ItemsControl x:Name="ExtChips" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Margin="0,0,6,6" Padding="10,4" Content="{Binding}" Click="ExtChip_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Панель инструментов -->
                        <DockPanel Grid.Row="2" Margin="0,16,10,12" LastChildFill="False">
                            <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="260" PlaceholderText="{DynamicResource Search.Placeholder}"
                                        TextChanged="SearchBox_TextChanged" ClearButtonEnabled="True">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Search24" />
                                </ui:TextBox.Icon>
                            </ui:TextBox>
                            <CheckBox x:Name="ShowSystemBox" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Content="{DynamicResource ShowSystem}" Checked="Filter_Changed" Unchecked="Filter_Changed" />

                            <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" ToolTip="{DynamicResource Tip.RestartExplorer}" Click="RestartExplorer_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" ToolTip="{DynamicResource Tip.Refresh}" Click="Refresh_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button x:Name="AddButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="{DynamicResource Btn.Add}" Click="AddItem_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Add24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button x:Name="PresetsButton" DockPanel.Dock="Right" Content="{DynamicResource Btn.Presets}" Click="Presets_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Wand24" />
                                </ui:Button.Icon>
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Preset.Clean}" Click="PresetClean_Click" />
                                        <MenuItem Header="{DynamicResource Preset.Dev}" Click="PresetDev_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Preset.AllOn}" Click="PresetAllOn_Click" />
                                        <MenuItem Header="{DynamicResource Preset.FixBroken}" Click="PresetFixBroken_Click" />
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                        </DockPanel>

                        <!-- Список + предпросмотр -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="PreviewColumn" Width="290" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <ScrollViewer x:Name="EntriesScroll" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                    <ItemsControl x:Name="EntriesList" Margin="0,0,10,16" ItemTemplate="{StaticResource EntryCard}" />
                                </ScrollViewer>
                                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <ui:SymbolIcon Symbol="Search24" FontSize="40" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="EmptyText" Margin="0,10,0,0" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="360" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Visibility="Collapsed"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Предпросмотр -->
                            <Border x:Name="PreviewPanel" Grid.Column="1" Margin="6,0,10,16" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Preview.Title}" />
                                    <TextBlock Style="{StaticResource CardText}" Margin="0,2,0,10" Text="{DynamicResource Preview.Note}" />
                                    <Border Padding="4" CornerRadius="8" BorderThickness="1"
                                            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" />
                                        </Border.Effect>
                                        <ItemsControl x:Name="PreviewList" ItemTemplate="{StaticResource PreviewRow}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Панель несохранённых изменений -->
                        <Border x:Name="PendingBar" Grid.Row="4" Margin="0,0,10,16" Padding="16,10" CornerRadius="8" BorderThickness="1"
                                Visibility="Collapsed"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                            <DockPanel LastChildFill="False">
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Edit24" FontSize="18"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="PendingText" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Primary" Content="{DynamicResource Btn.Apply}" Click="Apply_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Checkmark24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Btn.Cancel}" Click="Cancel_Click" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ================= Бэкапы ================= -->
                    <Grid x:Name="BackupsPanel" Visibility="Collapsed" Margin="28,22,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,10,18">
                            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Content="{DynamicResource Backups.OpenFolder}" Click="OpenBackupFolder_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{DynamicResource Nav.backups}" />
                                <TextBlock Style="{StaticResource PageSubStyle}" Text="{DynamicResource Backups.Desc}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="BackupsList" Margin="0,0,10,16" ItemTemplate="{StaticResource BackupCard}" />
                            </ScrollViewer>
                            <TextBlock x:Name="NoBackups" Text="{DynamicResource Backups.Empty}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Grid>

                    <!-- ================= Настройки ================= -->
                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,22,38,24" MaxWidth="900" HorizontalAlignment="Stretch">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{DynamicResource Nav.settings}" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Settings.Appearance}" />
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="22" />
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings.Language}" />
                                        <TextBlock Style="{StaticResource CardText}" Text="{DynamicResource Settings.Language.Desc}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LangCombo" Grid.Column="2" Width="170" VerticalAlignment="Center"
                                              SelectionChanged="LangCombo_SelectionChanged">
                                        <ComboBoxItem Content="Русский" Tag="ru" />
                                        <ComboBoxItem Content="English" Tag="en" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="DarkTheme24" FontSize="22" />
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings.Theme}" />
                                        <TextBlock Style="{StaticResource CardText}" Text="{DynamicResource Settings.Theme.Desc}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="170" VerticalAlignment="Center"
                                              SelectionChanged="ThemeCombo_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource Theme.System}" Tag="system" />
                                        <ComboBoxItem Content="{DynamicResource Theme.Dark}" Tag="dark" />
                                        <ComboBoxItem Content="{DynamicResource Theme.Light}" Tag="light" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Eye24" FontSize="22" />
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings.Preview}" />
                                        <TextBlock Style="{StaticResource CardText}" Text="{DynamicResource Settings.Preview.Desc}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="PreviewToggle" Grid.Column="2" VerticalAlignment="Center"
                                                     OnContent="{DynamicResource Toggle.On}" OffContent="{DynamicResource Toggle.Off}"
                                                     Click="PreviewToggle_Click" />
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource Settings.Tools}" />
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="22" />
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings.Profile}" />
                                        <TextBlock Style="{StaticResource CardText}" Text="{DynamicResource Settings.Profile.Desc}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="{DynamicResource Btn.Export}" Click="Export_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowUpload24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Margin="6,0,0,0" Content="{DynamicResource Btn.Import}" Click="Import_Click">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" />
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Settings.Check}" />
                                        <TextBlock Style="{StaticResource CardText}" Text="{DynamicResource Settings.Check.Desc}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" VerticalAlignment="Center" Content="{DynamicResource Btn.RunCheck}" Click="RunCheck_Click" />
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource About.Title}" />
                            <Border Style="{StaticResource Card}" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="64" Height="64" VerticalAlignment="Top" Source="pack://application:,,,/Assets/app.png"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Dredd Menu"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="VersionText" Margin="10,0,0,2" VerticalAlignment="Bottom" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,2,0,0" FontSize="13" Text="by PiloTDredd"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource CardText}" Margin="0,8,0,0" Text="{DynamicResource About.Desc}" />
                                        <WrapPanel Margin="0,14,0,0">
                                            <ui:Button x:Name="DonateButton" Appearance="Primary" Content="{DynamicResource About.Donate}" Click="Donate_Click">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Heart24" Filled="True" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button x:Name="GitHubButton" Margin="8,0,0,0" Content="GitHub" Click="GitHub_Click">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Code24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource CardText}" Margin="0,8,0,0" FontSize="11" Text="{DynamicResource About.Donate.Desc}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Всплывающее уведомление -->
                    <ui:InfoBar x:Name="Toast" Margin="24,0,34,18" VerticalAlignment="Bottom" MaxWidth="680"
                                IsOpen="False" IsClosable="True" Panel.ZIndex="10" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Проверка системы (поверх всего) ================= -->
        <Grid x:Name="CheckOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50" Background="#99000000">
            <Border Width="560" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24" CornerRadius="12"
                    BorderThickness="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.4" />
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="36" Height="36" Source="pack://application:,,,/Assets/app.png" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Check.Title}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="CheckSummary" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <ui:Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0" Appearance="Primary"
                               Content="{DynamicResource Btn.Continue}" Click="CloseCheck_Click" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CheckList" ItemTemplate="{StaticResource CheckRow}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
